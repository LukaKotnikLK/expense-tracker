@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Hello!</h1>
    <p>Learn about <a href="/Home/Info">Expense tracker</a>.</p>
</div>

<div class="text-center">
    <h2>Example dashboard</h2>
    <p>Title: @Model.Title</p>
    <p>Amount: @Model.Amount &euro;</p>
    <p>Date: @Model.Date</p>
</div>

<div class="text-center">
    <form method="post" action="/Home/Post">
        <div>
        <label for="Title">Name of Expense</label>
        <input type="text" id="Title" name="Title" required>
        </div>
        <br>
        <div
        <label for="Amount">Cost of Expense</label>
        <input type="text" id="Amount" name="Amount" required>
        </div>
        <br>
        <button type="submit">Add Expense</button>
    </form>
</div>